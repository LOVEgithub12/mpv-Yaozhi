+                                   : sub_is_primary_visible(obj->sub)))
+            res = sub_get_color_bitmaps(obj->sub);
     } else if (obj->type == OSDTYPE_EXTERNAL2 ||
                obj->type == OSDTYPE_DISC_MENU) {
         if (obj->image_overlay && obj->image_overlay->format) {
