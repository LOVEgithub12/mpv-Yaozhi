+// If out_color is non-NULL and the caller can render two layers, color bitmaps
+// go to their own BGRA layer there instead, and *out keeps the coverage format.
+// Splitting is what keeps the text out of the expensive path: a coverage layer
+// is one memcpy per bitmap, while a BGRA layer has to blend every pixel of its
+// ink in software (see pack_rgba), so merging the two makes all the text pay
+// for a handful of emoji.
 void mp_sub_packer_pack_ass(struct mp_sub_packer *p, ASS_Image **image_lists,
