         if (obj->sub && sub_is_secondary_visible(obj->sub))
             res = sub_get_bitmaps(obj->sub, obj->vo_res, format, video_pts);
         osd->secondary_has_output = res && res->num_parts > 0 && !res->static_image;
+    } else if (obj->type == OSDTYPE_SUB_COLOR ||
+               obj->type == OSDTYPE_SUB2_COLOR) {
+        // Side product of the matching text layer's get_bitmaps() call, which
+        // this object mirrors: that call happens earlier in this same pass, under
+        // the same lock, and with the same visibility predicate (including the
+        // extrapolated clock the secondary branch above uses), so the layer is
+        // for this exact pts.
+        bool secondary = obj->type == OSDTYPE_SUB2_COLOR;
