diff --git a/sub/dec_sub.c b/sub/dec_sub.c
index 33b3878..445c7a8 100644
--- a/sub/dec_sub.c
+++ b/sub/dec_sub.c
@@ -439,6 +439,24 @@ struct sub_bitmaps *sub_get_bitmaps(struct dec_sub *sub, struct mp_osd_res dim,
     return res;
 }
 
+// The color layer is a side product of sub_get_bitmaps(), so it only describes
+// the pts that call used. Mirroring that call's "subtitles already ended" guard
+// (sub->last_vo_pts is the pts it was handed) is what keeps a layer from
+// outliving the text it belongs to.
+struct sub_bitmaps *sub_get_color_bitmaps(struct dec_sub *sub)
+{
+    mp_mutex_lock(&sub->lock);
+
+    struct sub_bitmaps *res = NULL;
+
+    if (!(sub->end != MP_NOPTS_VALUE && sub->last_vo_pts >= sub->end) &&
+        sub->sd->driver->get_color_bitmaps)
+        res = sub->sd->driver->get_color_bitmaps(sub->sd);
+
+    mp_mutex_unlock(&sub->lock);
+    return res;
+}
+
 // The returned string is talloc'ed.
 char *sub_get_text(struct dec_sub *sub, double pts, enum sd_text_type type)
 {
