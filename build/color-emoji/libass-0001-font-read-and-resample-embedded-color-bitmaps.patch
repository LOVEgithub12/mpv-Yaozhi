--- a/libass/ass_cache.h
+++ b/libass/ass_cache.h
@@ -111,6 +111,7 @@ Cache *ass_outline_cache_create(void);
 Cache *ass_face_size_metrics_cache_create(void);
 Cache *ass_glyph_metrics_cache_create(void);
