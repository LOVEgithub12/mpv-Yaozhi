From 7d6f4a87f7f543d9c2f78885e47218269b9dd492 Mon Sep 17 00:00:00 2001
From: yaozhi-local <local@localhost>
Date: Sun, 1 Nov 2026 18:26:50 +0800
Subject: [PATCH 1/2] font: read and resample embedded color bitmaps

CBDT/CBLC and sbix faces store a glyph's artwork as a color bitmap at a fixed
resolution, which FreeType hands out only at that exact size. Add the plumbing
to fetch it: the strike of a face, its metrics for a requested em, and a
resample of the glyph into device pixels.

The resample is a box filter over premultiplied BGRA, which keeps a downscaled
strike from aliasing and lets the fractional part of the pen position be folded
into the filter weights instead of shifting the image. Results are cached per
font, scale, glyph and quarter-pixel pen phase, so scrolling text does not
resample every frame.

Faces that have no outlines at all are now registered too, since for them the
strike is the only thing worth drawing.
---
 libass/ass_cache.c          |  37 +++++++
 libass/ass_cache.h          |   1 +
 libass/ass_cache_template.h |  12 +++
 libass/ass_font.c           | 198 ++++++++++++++++++++++++++++++++++++
 libass/ass_font.h           |  29 ++++++
 libass/ass_fontselect.c     |   6 +-
 6 files changed, 281 insertions(+), 2 deletions(-)

diff --git a/libass/ass_cache.c b/libass/ass_cache.c
index 47069c1..b00e343 100644
--- a/libass/ass_cache.c
+++ b/libass/ass_cache.c
@@ -325,6 +325,38 @@ const CacheDesc glyph_metrics_cache_desc = {
 };
 
 
+// color bitmap cache
+static bool color_key_move(void *dst, void *src)
+{
+    ColorGlyphHashKey *d = dst, *s = src;
+    if (!d)
+        return true;
+
+    *d = *s;
+    ass_cache_inc_ref(s->font);
+    return true;
+}
+
+static void color_destruct(void *key, void *value)
+{
+    ColorGlyphHashKey *k = key;
+    ass_font_clear_color(value);
+    ass_cache_dec_ref(k->font);
+}
+
+size_t ass_color_construct(void *key, void *value, void *priv);
+
+const CacheDesc color_cache_desc = {
+    .hash_func = color_glyph_hash,
+    .compare_func = color_glyph_compare,
+    .key_move_func = color_key_move,
+    .construct_func = ass_color_construct,
+    .destruct_func = color_destruct,
+    .key_size = sizeof(ColorGlyphHashKey),
+    .value_size = sizeof(ColorBitmap)
+};
+
+
 
 // Cache data
 typedef struct cache_item {
@@ -570,6 +602,11 @@ Cache *ass_bitmap_cache_create(void)
     return ass_cache_create(&bitmap_cache_desc);
 }
 
+Cache *ass_color_cache_create(void)
+{
+    return ass_cache_create(&color_cache_desc);
+}
+
 Cache *ass_composite_cache_create(void)
 {
     return ass_cache_create(&composite_cache_desc);
diff --git a/libass/ass_cache.h b/libass/ass_cache.h
